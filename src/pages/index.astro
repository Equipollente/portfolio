---
// L'accueil. Les sections viennent du système et ne savent rien de ce site :
// c'est ici que tombent le visage, les textes, les études de cas et leurs images.
// Maquettes Figma : 45:388 (desktop), 142:1193 (mobile), 222:1168 (la pile).
//
// La page est bâtie sur le gabarit du système, src/pages/templates/home.astro :
// tout ce qu'elle apporte est dans le <style> ci-dessous, sous « le contrat du
// premier écran », et aucune de ces lignes n'est du JavaScript. Aucun des trois
// composants n'apprend l'existence des deux autres — le bouton de l'intro et
// l'onglet « Projets » pointent une ancre, la liste la porte, le navigateur fait
// le reste.
//
// La barre est montée ici et non par le layout, parce que c'est ce bloc-ci qui
// borne son collage : une barre posée par le layout resterait collée jusqu'au bas
// du document, par-dessus tout ce qui suit la pile.

import SiteLayout from '../site/layouts/SiteLayout.astro';
import Header from '../site/sections/Header.astro';
import Intro from 'ux-design-system/components/Intro.astro';
import CaseStudyList from 'ux-design-system/components/CaseStudyList.astro';
import { withBase } from 'ux-design-system/lib/url';

// Textes repris mot pour mot du nœud Figma 209:2348.
const intro = {
  avatar: { src: withBase('/images/avatar-judith.png'), alt: 'Judith Heckmann' },
  greeting: "Hello, I'm Judith",
  headline:
    'I design inclusive digital product experiences in a collaborative continuous discovery loop',
  description: 'From user insights to business impact. Outcomes are what I design for',
  // La flèche coude dit « descends dans la page », et c'est vrai depuis que la
  // pile porte l'ancre. Même destination que l'onglet « Projets » du Header.
  action: { label: 'Some projects I worked on', href: '#projets' },
};

// Les trois vignettes de 176:1248, de largeurs différentes — c'est ce qui fait
// travailler le carrousel. Elles sont servies par ce site, donc withBase().
const caseStudyImages = [
  {
    src: withBase('/images/case-study/rubika-percevoir.jpg'),
    alt: 'Guide « Percevoir sans lutter » : la page d’ouverture et ses deux principes perceptibles.',
    width: 822,
    height: 382,
  },
  {
    src: withBase('/images/case-study/rubika-agir.jpg'),
    alt: 'Guide « Agir sans difficultés » : les hypothèses de départ et leur vérification.',
    width: 271,
    height: 382,
  },
  {
    src: withBase('/images/case-study/rubika-roadmap.jpg'),
    alt: 'La feuille de route de l’atelier et la liste des participants.',
    width: 600,
    height: 382,
  },
];

// L'étude de cas de 176:1248, mot pour mot. Pas d'`action` : « Read the story »
// n'aurait nulle part où mener tant que les pages d'étude n'existent pas, et un
// bouton qui ne mène nulle part est un mensonge de plus qu'une case vide.
const rubika = {
  eyebrow: '2025 - Rubika',
  title: 'The 4 guides for designing for accessibility',
  impact: 'Faster deployments — Shared UX language — Roadmap alignment • User trust and satisfaction',
  tags: ['Hypothesis Testing', 'Co-design Facilitation', 'Journey Prototyping'],
  images: caseStudyImages,
};

// Figma ne dessine qu'une seule étude : sa « Case-Study Card2 » (222:831) est une
// copie de la première — un emplacement, pas un second contenu. Le code fait
// pareil et répète Rubika.
//
// Il ne faut surtout pas inventer ici des missions au nom d'entreprises réelles :
// cette page est publiée, et rien à l'écran ne distinguerait un remplissage d'une
// vraie étude de cas. Ajouter une étude, le jour venu, c'est ajouter un objet.
const caseStudies = [rubika, rubika, rubika];
---

<SiteLayout
  title="Judith Heckmann — Product designer"
  description="Portfolio UX de Judith Heckmann : projets, méthode de travail et CV."
  header={false}
>
  <div class="home">
    {/* La pile, et ce qui la porte. Ce bloc borne le collage : c'est lui qui dit
        où le premier écran cesse de tenir sa place. Sans lui, l'intro resterait
        collée jusqu'au bas de la page et se peindrait par-dessus tout ce qui
        suit la pile — un élément positionné passe devant un élément qui ne
        l'est pas, quel que soit l'ordre du DOM. */}
    <div class="home-deck">
      {/* La barre est hors du premier écran, et il faut les deux raisons pour
          comprendre pourquoi : un élément collé crée un contexte d'empilement,
          donc aucun z-index posé à l'intérieur du premier écran ne la ferait
          passer devant les cartes ; et CaseStudyList rend ce bloc inerte dès
          qu'une carte le recouvre, ce qui sortirait ses onglets du clavier. Elle
          reste dans le flux, et sa hauteur est un token — nav.height — que le bloc
          ci-dessous lit sans avoir à la mesurer. */}
      <Header />

      {/* Le premier écran : l'intro. C'est la couche du dessous de la pile — il
          tient sa place et les cartes lui passent dessus. Sa hauteur est ce qui
          fait affleurer la première carte, et rien d'autre : le liseré est ce
          qu'on lui retire, --fold-peek. */}
      <div class="home-first" id="accueil">
        <div class="intro-slot">
          <Intro
            avatar={intro.avatar}
            greeting={intro.greeting}
            headline={intro.headline}
            description={intro.description}
            action={intro.action}
          />
        </div>
      </div>

      <CaseStudyList id="projets" covers="accueil" items={caseStudies} label="Études de cas" />
    </div>

    {/* Le palier qui suit la pile. Vide, et c'est provisoire : il est là pour que
        la dernière carte ait un sol derrière elle plutôt que le bord du document.
        Juste assez haut pour se voir, pas assez pour manger la carte — le
        pourquoi est dans .after. La première section qui arrivera sur l'accueil —
        « How I work », un contact — prendra sa place et lui donnera un contenu,
        et il faudra alors lui rendre de la hauteur. */}
    <div class="after"></div>
  </div>
</SiteLayout>

<style>
  /* ── Le contrat du premier écran ─────────────────────────────────────────
     C'est tout ce qu'une page doit savoir de CaseStudyList. Il vit ici et non
     dans le composant parce que la liste ne peut pas mesurer ce qui la précède —
     et que le mesurer en JavaScript ferait sauter la carte au chargement. */

  .home {
    /* Déclaré une seule fois : le premier écran et la pile lisent le même nombre.
       Il vaut deux fois — le liseré de carte qui dépasse sous le bas de l'écran,
       et le chevauchement entre deux cartes, qui est le même écart vu de l'autre
       côté. Le changer ici les déplace ensemble, et c'est voulu.
       90 est la valeur du système, et un arbitrage : Figma pose 50 en itemSpacing
       (209:2383), mais ce 50 n'est pas le liseré — celui qu'il dessine n'est pas
       constant. Aucun token ne le porte. Le raisonnement est écrit une fois pour
       toutes sur /components, section Case Study List.
       Déclaré ici bien que le composant ait le même repli : une page qui pose sa
       propre géométrie ne doit pas dépendre d'un défaut. */
    --fold-peek: 90px;
  }

  /* --nav-height n'est pas déclarée ici, seulement lue : c'est le token
     nav.height, qui vient de Figma en deux valeurs — 88, et 72 en mode Mobile.
     Une page cale son premier écran sous la barre sans rien savoir de ce qui la
     compose. */

  /* .home-deck n'a volontairement aucune déclaration, et ce n'est pas un oubli :
     tout son rôle est d'exister comme bloc, pour servir de repère au collage de
     la barre, du premier écran et des cartes. C'est lui qui dit où ce collage
     s'arrête — au bas de la pile, et non au bas de la page. Lui donner un style
     le rendrait visible ; il ne doit pas l'être. */

  /* Le premier écran est la couche du dessous : il reste en place, et les cartes
     lui passent dessus. Comme les couches de cartes sont peintes après lui dans
     l'ordre du DOM, elles le recouvrent sans qu'aucun z-index soit écrit.
     Collé à .home-deck et non à .home : son collage doit cesser avec la pile,
     sinon il se peindrait par-dessus tout ce qui suit.
     Une hauteur, et non un plancher : c'est elle qui garantit le liseré à toute
     hauteur d'écran. Avec min-height, un contenu un peu grand pousserait le bloc
     et mangerait le liseré. */
  .home-first {
    position: sticky;
    /* Sous la barre, et non sous le haut de la fenêtre : sans quoi l'intro
       glisserait derrière elle pendant les cent premiers pixels, avant que le
       masquage ne s'enclenche. */
    top: var(--nav-height);
    display: flex;
    flex-direction: column;
    /* La barre reste dans le flux — un élément collé garde sa place — donc le
       premier écran fait toujours 100svh moins le liseré en tout, barre
       comprise : le liseré ne bouge pas d'un pixel. */
    height: calc(100vh - var(--fold-peek) - var(--nav-height));
    height: calc(100svh - var(--fold-peek) - var(--nav-height));
  }

  /* La nav n'a plus de règle ici : elle porte son propre collage, par sa prop
     sticky, et le même à toutes les largeurs. Il n'y a plus de relais à passer
     entre desktop et mobile, ni d'ordre d'empilement déduit du positionnement des
     couches — la barre écrit son rang, une fois, et il vaut des deux côtés du
     point de rupture. */

  /* L'intro prend l'air qui reste, centrée : le mou se répartit au-dessus et
     au-dessous d'elle. Figma pose un écart sous elle (209:2383), mais Figma ne
     dessine aucun mou — son premier écran fait exactement la taille de son
     contenu. Ajouter ce padding en plus du centrage ne ferait que décaler le
     bloc vers le haut, et il ne tiendrait pas sur une fenêtre basse : l'écart
     est donc celui du centrage, et rien d'autre.
     min-height: 0 lève la taille minimale automatique des boîtes flexibles, sans
     quoi l'intro refuserait de se resserrer sur une fenêtre courte. */
  .intro-slot {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    /* `safe` : sous ~690px de fenêtre, l'intro ne tient plus dans son écran moins
       le liseré. Centrée, elle déborderait des deux côtés et remonterait sur la
       nav. En alignement sûr, le centrage cède au profit du haut dès que ça
       déborde : l'intro reste sous la nav et ne dépasse que par le bas, où la
       carte la recouvre de toute façon. Là où le mot-clé n'est pas connu, on
       retombe sur le centrage — le comportement d'avant. */
    justify-content: safe center;
  }

  /* Le palier ne fait plus un écran : à cette taille, il occupait le bas de la
     fenêtre en fin de défilement et il ne restait qu'un bandeau de la dernière
     carte à l'écran. Une couche de carte fait exactement un écran et son collage
     s'arrête au bas de la pile — donc tout ce que le palier prend en hauteur, la
     dernière carte le perd, et rien ne le lui rend.
     Le liseré est la mesure juste : la pile s'ouvre sur 90px de carte qui
     affleure et se referme sur 90px de sol. C'est le seul nombre à régler si le
     bas de page paraît encore trop long ou trop court. */
  .after {
    /* `relative` sans décalage : il ne déplace rien, il change de couche. Sur une
       fenêtre courte, l'intro déborde de son écran par le bas — c'est assumé,
       une carte passe dessus. Mais en fin de page il n'y a plus de carte, et le
       bas de l'intro tombait dans le palier : collé, .home-first est un élément
       positionné, et un élément positionné se peint par-dessus un élément qui ne
       l'est pas, quel que soit l'ordre du DOM. Le fond ne suffisait donc pas — il
       était peint dans la mauvaise couche. Positionné, le palier passe devant :
       il devient le sol qui recouvre, comme les cartes avant lui, et sans qu'un
       z-index soit écrit. */
    position: relative;
    min-height: var(--fold-peek);
    /* Et c'est ce fond qui recouvre vraiment. Même couleur que le body — donc
       rien ne bouge ailleurs — mais le palier est désormais opaque en propre. */
    background: var(--color-bg-default);
  }

  /* Sous ~690px de fenêtre, l'intro ne tient plus dans son écran moins le liseré :
     il lui faut 513px, plus --nav-height et le liseré. C'est le liseré qui gagne
     — la consigne est qu'il tienne à toute hauteur — donc c'est l'intro qui se
     resserre : son grand écart interne retombe à space.xl, ce qui lui rend 40px
     et la fait tenir jusqu'à ~651px. En dessous, elle dépasse par le bas, où la
     carte la recouvre.
     Le nombre 690 est calculé sur les 88px de --nav-height en desktop. En mobile
     la barre n'en fait que 72, donc le seuil se déclenche une quinzaine de pixels
     trop tôt : l'intro se resserre avant d'en avoir besoin. C'est le bon côté de
     l'erreur — et ce seuil, longtemps théorique, est devenu le cas courant depuis
     que la pile s'empile aussi sur téléphone.
     Il est dérivé de --fold-peek : il suit le liseré pixel pour pixel, et doit
     être recalculé si celui-ci change. */
  @media (max-height: 690px) {
    .intro-slot {
      --intro-gap: var(--space-xl);
    }
  }

  /* Aucune bascule sous 768px, et ce n'est pas un oubli. Le premier écran reste
     une couche à toutes les largeurs, comme la pile s'empile à toutes les
     largeurs depuis que le système a retiré son repli mobile : c'est ce qui
     garantit le liseré partout, dès le chargement, y compris sur téléphone.
     Ce que ça coûte est un arbitrage tranché, pas un défaut : l'intro déborde
     par le bas sur un écran de téléphone — son titre s'y replie sur sept lignes
     — et la carte passe dessus, description et bouton compris. Le liseré prime
     sur ce qui dépasse. C'est exactement ce que fait déjà une fenêtre de bureau
     trop courte, et `justify-content: safe center` le fait tomber du bon côté :
     l'intro reste sous la nav et ne dépasse que par le bas, là où quelque chose
     la recouvre toujours.
     Détail et mesures sur /components → Case Study List du design system. */
</style>
