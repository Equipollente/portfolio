---
// L'executive d'une étude de cas — Figma Folio2026 107:175. Partie fixe du
// layout global : trois cartes sur une bande bg.surface, pour qui ne lira que ça.
//
// La bande n'a pas de titre dans la maquette ; elle en reçoit un pour les
// technologies d'assistance seulement, et les cartes deviennent ses h3.

import ExecutiveCard from '../../components/case-study/ExecutiveCard.astro';
import type { ExecutiveIcon, ExecutiveTone } from '../../components/case-study/executive';

interface Props {
  items: { icon: ExecutiveIcon; tone: ExecutiveTone; title: string; bullets: string[] }[];
  lang?: string;
}

const { items, lang } = Astro.props;
---

<section class="executive" aria-labelledby="case-executive" lang={lang}>
  <h2 id="case-executive" class="visually-hidden">Executive summary</h2>
  <div class="cards">
    {items.map((item) => <ExecutiveCard {...item} headingLevel={3} />)}
  </div>
</section>

<style>
  .executive {
    /* La largeur minimale d'une carte : 239 px dans Figma. */
    --executive-card-min: 15rem;

    /* Figma empile deux cadres : 32 px de bande, puis 48 px de rangée. */
    padding-block: calc(var(--space-2xl) + var(--space-layout-48));
    padding-inline: var(--case-gutter);
    background: var(--color-bg-surface);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--executive-card-min), 1fr));
    align-items: start;
    gap: var(--space-layout-48);
    max-inline-size: calc(var(--case-width) - 2 * var(--space-layout-64));
    margin-inline: auto;
  }

  @media (max-width: 767px) {
    .cards {
      gap: var(--space-xl);
    }
  }

  /* Le motif « visually hidden » : une boîte d'un pixel, hors du rendu, lue par
     les technologies d'assistance. Ces 1px ne sont pas une mesure de design. */
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
