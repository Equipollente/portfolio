---
// Header du portfolio — une composition, pas un composant de système : il rend
// la barre collante et fournit au Nav du design system ce que celui-ci ignore,
// à savoir les pages du site et celle où l'on se trouve.
// Spécifié par deux nœuds Figma : 60:992 (accueil) et 166:475 (autres pages).

import Nav from 'ux-design-system/components/Nav.astro';
import { withBase } from 'ux-design-system/lib/url';

const links = [
  { href: withBase('/projets'), label: 'Projets', icon: withBase('/icons/box-plus.svg') },
  { href: withBase('/how-i-work'), label: 'How I work', icon: withBase('/icons/route.svg') },
  { href: withBase('/about'), label: 'About me', icon: withBase('/icons/circle-face.svg') },
  { href: withBase('/cv'), label: 'CV', icon: withBase('/icons/file-text.svg') },
];

// Astro.url.pathname porte le préfixe de déploiement, et les liens aussi depuis
// withBase() : on compare donc l'accueil à withBase('/') et non à '/'. Sans ça,
// l'accueil ne se reconnaît pas et propose un retour vers lui-même.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const accueil = withBase('/').replace(/\/$/, '') || '/';
const isHome = path === accueil;

// Sur l'accueil, l'avatar disparaît — il n'y a pas à proposer un retour vers la
// page où l'on est. Et comme « / » ne figure pas dans les liens, aucun onglet
// n'y est actif : c'est bien ce que montre le design, la HP n'est pas un item.
const home = isHome
  ? undefined
  : { href: withBase('/'), src: withBase('/images/avatar-judith.png'), alt: 'Accueil' };
---

<header class="header">
  {/* Sans href, Button rend un <button> : c'est la bonne balise pour ce qui
      ouvrira une pop-up de contact. Reste à câbler. */}
  <Nav
    links={links}
    current={path}
    home={home}
    action={{ label: "Let's chat", icon: withBase('/icons/mail-edit.svg') }}
  />
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    background: var(--color-bg-default);
  }
</style>
