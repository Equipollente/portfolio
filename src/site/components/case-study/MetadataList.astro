---
// MetadataList — les faits d'une étude, en libellés et en tags : rôle, livrables,
// équipe. Figma Folio2026 : casestudy-metadata-list (81:2755) et
// casestudy-metadata-item (81:2748).
//
// Une liste de définitions : un libellé (<dt>) pour une ou plusieurs valeurs
// (<dd>), ce qui est exactement ce que la maquette dessine.
//
// Écart assumé : Figma pose des tags accent.100 à encre text.default en
// body/default. Le Tag du système, variante `accent`, garde la paire 100/800 et
// sa propre typographie — c'est lui qui fait foi, et c'est dans Figma que l'écart
// se corrige.

import type { HTMLAttributes } from 'astro/types';
import Tag from 'ux-design-system/components/Tag.astro';

interface Props extends HTMLAttributes<'dl'> {
  items: { label: string; tags: string[] }[];
}

const { items, class: className, ...rest } = Astro.props;
---

<dl class:list={['metadata', className]} {...rest}>
  {
    items.map(({ label, tags }) => (
      <div class="item">
        <dt>{label}</dt>
        {tags.map((tag) => (
          <dd>
            <Tag variant="accent">{tag}</Tag>
          </dd>
        ))}
      </div>
    ))
  }
</dl>

<style>
  .metadata {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin: 0;
    padding: var(--space-lg);
    background: var(--color-bg-default);
  }

  .item {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Le libellé prend toute la ligne, les tags se rangent dessous. */
  dt {
    flex-basis: 100%;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-body-sm);
    line-height: var(--font-line-height-snug);
    letter-spacing: var(--font-letter-spacing-wider);
    text-transform: uppercase;
  }

  dd {
    margin: 0;
  }
</style>
