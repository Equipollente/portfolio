---
// BulletList — une liste à puces courte. Figma Folio2026 : section-body-list
// (97:118), dans le slot « Bullets » de l'executive-card.
//
// La puce est un pseudo-élément et non l'image exportée : Figma la dessine dans
// une boîte de 10 × 26 px, la hauteur d'une ligne de body/lead, pour qu'elle
// reste alignée sur la première ligne quand le texte passe à la ligne.

import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'ul'> {
  items: string[];
}

const { items, class: className, ...rest } = Astro.props;
---

<ul class:list={['bullets', className]} {...rest}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .bullets {
    /* La pastille de Figma : 6 px, centrée dans une boîte d'une ligne de haut.
       Aucun token de taille d'ornement n'existe. */
    --bullet-size: 0.375rem;

    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-body-lg);
    line-height: var(--font-line-height-body);
  }

  li {
    display: flex;
    gap: var(--space-sm);
  }

  li::before {
    content: '';
    flex: none;
    inline-size: var(--bullet-size);
    block-size: var(--bullet-size);
    /* Centre la pastille sur la première ligne : une demi-ligne, moins une
       demi-pastille. */
    margin-block-start: calc(0.5lh - var(--bullet-size) / 2);
    border-radius: var(--radius-pill);
    background: var(--color-neutral-300);
  }
</style>
